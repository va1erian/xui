Form(name: "login_form", title: "Sign in", size: (320, 168), root: Column(gap: 12, padding: 16, children: [
    Grid(columns: [
        Auto,
        Fill(1),
    ], gap: 8, children: [
        Label(text: "User name"),
        Edit(name: "user_edit", placeholder: "your name"),
        Label(text: "Password"),
        Edit(name: "password_edit", placeholder: "password", password: true),
        Label(),
        CheckBox(name: "remember_check", text: "Remember me"),
    ]),
    Row(gap: 8, children: [
        Label(name: "status_label", fill: 1),
        Button(name: "sign_in_button", text: "Sign in"),
        Button(name: "cancel_button", text: "Cancel"),
    ]),
]))
