Form(name: "calculator", title: "Calculator", size: (240, 196), root: Grid(columns: [
    Fill(1),
    Fill(1),
    Fill(1),
    Fill(1),
], gap: 8, padding: 12, children: [
    Label(name: "display", text: "0", span: 4),
    Button(name: "digit", index: 7, text: "7"),
    Button(name: "digit", index: 8, text: "8"),
    Button(name: "digit", index: 9, text: "9"),
    Button(name: "operator", index: 0, text: "/"),
    Button(name: "digit", index: 4, text: "4"),
    Button(name: "digit", index: 5, text: "5"),
    Button(name: "digit", index: 6, text: "6"),
    Button(name: "operator", index: 1, text: "*"),
    Button(name: "digit", index: 1, text: "1"),
    Button(name: "digit", index: 2, text: "2"),
    Button(name: "digit", index: 3, text: "3"),
    Button(name: "operator", index: 2, text: "-"),
    Button(name: "digit", index: 0, text: "0"),
    Button(name: "clear", text: "C"),
    Button(name: "equals", text: "="),
    Button(name: "operator", index: 3, text: "+"),
]))
